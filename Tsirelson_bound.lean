def CVP_Instance (n : Type) [Fintype n] (R : Type) [CommRing R] :=
  Matrix n n R × (n → R)

def Hodge_Instance (N : Type) [Fintype N] (R : Type) [CommRing R] :=
  Matrix N N R × (N → R)

def is_harmonic {N : Type} [Fintype N] {R : Type} [CommRing R]
  (Δ : Matrix N N R) (h : N → R) : Prop :=
  Matrix.mulVec Δ h = 0

def Hodge_Solver_Correct {N : Type} [Fintype N] {R : Type} [CommRing R]
  (solver : (N → R) → (N → R)) (Δ : Matrix N N R) (b : N → R) : Prop :=
  is_harmonic Δ (solver b) ∧ (solver b = b)

theorem Hodge_Hardness_Reduction
  {n : Type} [Fintype n] [DecidableEq n]
  {R : Type} [Field R]
  (solver : (n → R) → (n → R))
  (h_solver : ∀ (Δ : Matrix n n R) (b : n → R),
    is_harmonic Δ (solver b) ∧
    True) :
  ∀ (B : Matrix n n R) (t : n → R),
    ∃ (Δ : Matrix n n R),
      (∀ v, Matrix.mulVec Δ v = 0 ↔ ∃ x, Matrix.mulVec B x = v) ∧
      (∃ x, Matrix.mulVec B x = solver t) :=
  by
    intro B t;
    -- Let $W$ be the subspace spanned by the columns of $B$.
    set W := LinearMap.range (Matrix.mulVecLin B);
    -- Let $Δ$ be a matrix whose null space is $W$.
    obtain ⟨Δ, hΔ⟩ : ∃ Δ : Matrix n n R, LinearMap.ker (Matrix.mulVecLin Δ) = W := by
      -- Let $Δ$ be a matrix whose null space is $W$. We can construct such a matrix using the fact that $W$ is a subspace of $\mathbb{R}^n$.
      obtain ⟨Δ, hΔ⟩ : ∃ Δ : (n → R) →ₗ[R] (n → R), LinearMap.ker Δ = W := by
        -- Let $U$ be a complement of $W$ in $(n → R)$.
        obtain ⟨U, hU⟩ : ∃ U : Submodule R (n → R), IsCompl W U := by
          exact?;
        -- Let $P$ be the projection onto $U$ along $W$.
        obtain ⟨P, hP⟩ : ∃ P : (n → R) →ₗ[R] (n → R), ∀ v : n → R, P v ∈ U ∧ v - P v ∈ W := by
          have h_proj : ∀ v : n → R, ∃! p : n → R, p ∈ U ∧ v - p ∈ W := by
            intro v
            obtain ⟨p, hp⟩ : ∃ p : n → R, p ∈ U ∧ v - p ∈ W := by
              have := Submodule.mem_sup.mp ( show v ∈ W ⊔ U from by rw [ hU.sup_eq_top ] ; exact Submodule.mem_top ) ; aesop;
            refine' ⟨ p, hp, fun q hq => _ ⟩;
            have h_eq : q - p ∈ W ∧ q - p ∈ U := by
              exact ⟨ by simpa using W.sub_mem hp.2 hq.2, by simpa using U.sub_mem hq.1 hp.1 ⟩;
            have := hU.disjoint.le_bot h_eq; simp_all +decide [ sub_eq_iff_eq_add ] ;
          choose P hP₁ hP₂ using h_proj;
          refine' ⟨ { toFun := P, map_add' := _, map_smul' := _ }, hP₁ ⟩;
          · intro x y; specialize hP₂ ( x + y ) ( P x + P y ) ; simp_all +decide [ Submodule.add_mem_iff_right, Submodule.add_mem_iff_left ] ;
            exact Eq.symm ( hP₂ ( by simpa [ add_sub_add_comm ] using Submodule.add_mem _ ( hP₁ x |>.2 ) ( hP₁ y |>.2 ) ) );
          · -- By the uniqueness part of hP₂, since m • P(x) is in U and m • x - m • P(x) is in W, we have P(m • x) = m • P(x).
            intros m x
            have h_unique : m • P x ∈ U ∧ m • x - m • P x ∈ W := by
              exact ⟨ U.smul_mem _ ( hP₁ x |>.1 ), by simpa only [ smul_sub ] using W.smul_mem _ ( hP₁ x |>.2 ) ⟩;
            exact hP₂ _ _ h_unique ▸ rfl;
        use P;
        ext v; simp [hP];
        constructor <;> intro hv <;> have := hP v <;> simp_all +decide [ sub_eq_zero ];
        have := hP v; have := hU.disjoint.le_bot ( show P v ∈ W ⊓ U from ⟨ by simpa using Submodule.sub_mem _ hv this.2, this.1 ⟩ ) ; aesop;
      -- Since Δ is a linear map, we can represent it as a matrix.
      obtain ⟨Δ_matrix, hΔ_matrix⟩ : ∃ Δ_matrix : Matrix n n R, Δ = Matrix.mulVecLin Δ_matrix := by
        use LinearMap.toMatrix' Δ;
        ext; simp [LinearMap.toMatrix'];
      aesop;
    simp_all +decide [ SetLike.ext_iff, LinearMap.mem_ker ];
    exact ⟨ ⟨ Δ, fun v => by aesop ⟩, hΔ _ |>.1 ( h_solver Δ t ) ⟩

theorem Hodge_Ambiguity
  {n : Type} [Fintype n] [DecidableEq n]
  {R : Type} [Field R] [DecidableEq R]
  (h_dim : Fintype.card n ≥ 2) :
  ∃ (Δ₁ Δ₂ : Matrix n n R) (b : n → R),
    (∃ h₁, is_harmonic Δ₁ h₁ ∧ h₁ = b) ∧
    (¬ ∃ h₂, is_harmonic Δ₂ h₂ ∧ h₂ = b)
    :=
  by
    -- Let's choose Δ₁ to be the zero matrix and Δ₂ to be the identity matrix.
    use 0, 1, fun _ => 1;
    -- For the first part, any vector h₁ is harmonic for the zero matrix since 0 * h₁ = 0.
    simp [is_harmonic];
    -- The zero function and the constant function 1 are not equal because they produce different outputs for any input.
    intro h_eq
    have := congr_fun h_eq (Classical.choose (Finset.card_pos.mp (by linarith : 0 < Fintype.card n)))
    simp at this

def LaplacianSpace {n : Type} [Fintype n] {R : Type} [RCLike R] [DecidableEq n] (β : Nat) : Set (Matrix n n R) :=
  { Δ | Δ.IsHermitian ∧ (∀ x : n → R, 0 ≤ RCLike.re (star x ⬝ᵥ Δ.mulVec x)) ∧ Module.finrank R (LinearMap.ker (Matrix.mulVecLin Δ)) = β }

def SpectralGap {n : Type} [Fintype n] {R : Type} [RCLike R] [DecidableEq n] (Δ : Matrix n n R) (hΔ : Δ.IsHermitian) : Real :=
  let evals := hΔ.eigenvalues
  if ∃ i, evals i ≠ 0 then
    sInf { x | ∃ i, evals i = x ∧ x ≠ 0 }
  else 0

def MaxEigenvalue {n : Type} [Fintype n] {R : Type} [RCLike R] [DecidableEq n] (Δ : Matrix n n R) (hΔ : Δ.IsHermitian) : Real :=
  sSup { x | ∃ i, hΔ.eigenvalues i = x }

example {n : Type} [Fintype n] {R : Type} [RCLike R] : InnerProductSpace R (EuclideanSpace R n) := by infer_instance

