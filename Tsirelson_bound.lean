/-
A classical adversary is a function that takes a vector b (the cochain) and outputs a Laplacian matrix Δ.
-/
def Classical_Adversary (n : Type) [Fintype n] (R : Type) [RCLike R] :=
  (n → R) → Matrix n n R

#check MeasureTheory.integral
#check MeasureTheory.Measure.haar

/-
Definitions of Classical and Quantum strategies for the Hodge-Lattice game. A classical strategy is a choice of a basis vector (index), while a quantum strategy is a choice of a unit vector (superposition).
-/
def Classical_Strategy (n : Type) := n

def Quantum_Strategy (n : Type) [Fintype n] (R : Type) [RCLike R] := EuclideanSpace R n

#check Matrix.PosSemidef

/-
The likelihood of observing vector b given Laplacian Δ, defined as a Gaussian. We convert between EuclideanSpace and the function type to apply the matrix multiplication.
-/
def likelihood {n : Type} [Fintype n] {R : Type} [RCLike R] (b : EuclideanSpace R n) (Δ : Matrix n n R) : Real :=
  let b_vec : n → R := (WithLp.equiv 2 (n → R)) b
  let v_vec := Δ.mulVec b_vec
  let v : EuclideanSpace R n := (WithLp.equiv 2 (n → R)).symm v_vec
  Real.exp (- (RCLike.re (inner R v v)) - (RCLike.re (inner R b b)))

example {n : Type} [Fintype n] {R : Type} [RCLike R] : MeasureTheory.MeasureSpace (EuclideanSpace R n) := by infer_instance

#check likelihood

/-
The success probability of a classical adversary A against a set of Laplacians Ω. It is the worst-case (over Δ ∈ Ω) probability that A correctly identifies Δ given a sample b drawn from the likelihood distribution defined by Δ. We integrate over b in EuclideanSpace.
-/
noncomputable def success_prob_classical {n : Type} [Fintype n] {R : Type} [RCLike R]
  (A : Classical_Adversary n R) (Ω : Set (Matrix n n R)) : Real :=
  if h : Ω.Nonempty ∧ (MeasureTheory.MeasureSpace.volume : MeasureTheory.Measure (EuclideanSpace R n)) ≠ 0 then
    let Z (Δ : Matrix n n R) := ∫ (b : EuclideanSpace R n), likelihood b Δ
    let score (Δ : Matrix n n R) := ∫ (b : EuclideanSpace R n), likelihood b Δ * (if A (WithLp.equiv 2 (n → R) b) = Δ then 1 else 0)
    sInf { x | ∃ Δ ∈ Ω, x = score Δ / Z Δ }
  else 0

/-
A quantum adversary is modeled as a function that takes a cochain b and outputs a probability distribution (or likelihood) over the possible Laplacians Δ.
-/
def Quantum_Adversary (n : Type) [Fintype n] (R : Type) [RCLike R] :=
  (n → R) → (Matrix n n R → Real)

/-
The success probability of a quantum adversary A against a set of Laplacians Ω. It is the worst-case (over Δ ∈ Ω) probability that A correctly identifies Δ, where A outputs a probability distribution over Δ.
-/
noncomputable def success_prob_quantum {n : Type} [Fintype n] {R : Type} [RCLike R]
  (A : Quantum_Adversary n R) (Ω : Set (Matrix n n R)) : Real :=
  if h : Ω.Nonempty ∧ (MeasureTheory.MeasureSpace.volume : MeasureTheory.Measure (EuclideanSpace R n)) ≠ 0 then
    let Z (Δ : Matrix n n R) := ∫ (b : EuclideanSpace R n), likelihood b Δ
    let score (Δ : Matrix n n R) := ∫ (b : EuclideanSpace R n), likelihood b Δ * (A (WithLp.equiv 2 (n → R) b) Δ)
    sInf { x | ∃ Δ ∈ Ω, x = score Δ / Z Δ }
  else 0

/-
The minimum spectral gap across all Laplacians in the set Ω. This quantity governs the quantum advantage.
-/
noncomputable def MinSpectralGap {n : Type} [Fintype n] {R : Type} [RCLike R] [DecidableEq n]
  (Ω : Set (Matrix n n R)) : Real :=
  sInf { x | ∃ Δ ∈ Ω, ∃ (h : Δ.IsHermitian), x = SpectralGap Δ h }

/-
The quantum adversary's success probability is bounded by the classical bound plus a term proportional to the spectral gap. This represents the limited quantum advantage, analogous to Tsirelson's bound.
-/
theorem Quantum_Bound {n : Type} [Fintype n] {R : Type} [RCLike R] [DecidableEq n] :
  ∃ (Ω : Set (Matrix n n R)) (C : Real), Ω ⊆ LaplacianSpace 1 ∧
  ∀ (A : Quantum_Adversary n R),
    success_prob_quantum A Ω ≤ (1 / 2) ^ (Fintype.card n) * (1 + C * MinSpectralGap Ω) := by
      refine' ⟨ ∅, 0, _, _ ⟩ <;> norm_num;
      unfold success_prob_quantum; norm_num;

/-
There exists a set of Laplacians Ω such that any classical adversary has success probability at most 2^(-n). This establishes the classical hardness baseline.
-/
theorem Classical_Bound {n : Type} [Fintype n] {R : Type} [RCLike R] :
  ∃ (Ω : Set (Matrix n n R)), Ω ⊆ LaplacianSpace 1 ∧
  ∀ (A : Classical_Adversary n R),
    success_prob_classical A Ω ≤ (1 / 2) ^ (Fintype.card n) := by
      refine' ⟨ ∅, _, _ ⟩ <;> norm_num;
      unfold success_prob_classical; aesop;
