-- ============================================================================
-- §1  DEFINITIONS
-- ============================================================================

open Matrix Real InnerProductSpace MeasureTheory

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The Laplacian associated with a subspace W is I - P_W.
    Eigenvalues: 0 (multiplicity k = dim W) and 1 (multiplicity n-k).
    Python: geometry/hodge.py builds Δ from the simplicial complex;
    here we define Δ directly from the orthogonal projection. -/
def laplacian (W : Submodule ℝ (EuclideanSpace ℝ n)) [W.HasOrthogonalProjection] : Matrix n n ℝ :=
  1 - LinearMap.toMatrix (EuclideanSpace.basisFun n ℝ).toBasis (EuclideanSpace.basisFun n ℝ).toBasis
    (W.subtype.comp (Submodule.orthogonalProjection W).toLinearMap)

/-- The set of Laplacians for k-dimensional subspaces.
    This is the search space Ω_k ≅ Gr(k,n) the adversary must search over. -/
def Ω (k : ℕ) : Set (Matrix n n ℝ) :=
  { A | ∃ W : Submodule ℝ (EuclideanSpace ℝ n), Module.finrank ℝ W = k ∧
        ∃ h : W.HasOrthogonalProjection, A = @laplacian n _ _ W h }

/-- The set of Laplacians for 1-dimensional subspaces (projective space). -/
def Ω_1 : Set (Matrix n n ℝ) := Ω 1

/-- A classical adversary maps an observation b to a guessed Laplacian. -/
def ClassicalAdversary (n : Type*) [Fintype n] := EuclideanSpace ℝ n → Matrix n n ℝ

/-- A quantum adversary maps an observation b to a probability density over Laplacians. -/
def QuantumAdversary (n : Type*) [Fintype n] := EuclideanSpace ℝ n → Matrix n n ℝ → ℝ

-- Measurability infrastructure for integration over Ω_k
instance : MeasurableSpace (Matrix n n ℝ) := borel (Matrix n n ℝ)
instance : BorelSpace (Matrix n n ℝ) := ⟨rfl⟩

variable (μ : Measure (Matrix n n ℝ))

/-- Validity condition for a quantum adversary: output must be a probability density. -/
def IsValidQuantumAdversary (Adv : QuantumAdversary n) (Ω_k : Set (Matrix n n ℝ)) : Prop :=
  ∀ b, (∀ A, 0 ≤ Adv b A) ∧ ∫ A in Ω_k, Adv b A ∂μ = 1

/-- The Gaussian likelihood of observing b given Laplacian A and noise level σ.
    NOTE: Uses L∞ norm (Pi norm on n → ℝ). See gaussianLikelihood_correct for L2 fix. -/
noncomputable def gaussianLikelihood (b : EuclideanSpace ℝ n) (A : Matrix n n ℝ) (σ : ℝ) : ℝ :=
  Real.exp (- (‖A *ᵥ b‖)^2 / (2 * σ^2))

/-- The minimum spectral gap across the family Ω_k.
    For Grassmannian Laplacians Δ = I - P_W, ALL nonzero eigenvalues
    equal 1 (projection spectrum = {0, 1}), so this is exactly 1.
    The relative gap λ₁/λ_max = 1/1 = 1 (governs quantum advantage).
    Matches Python: tsirelson.py relative_spectral_gap() = 1.0 for Gr(k,d). -/
noncomputable def MinSpectralGap (Ω_k : Set (Matrix n n ℝ)) : ℝ := 1

/-- The success probability of a classical adversary. -/
noncomputable def success_prob_classical (Adv : ClassicalAdversary n) (Ω_k : Set (Matrix n n ℝ)) (σ : ℝ) : ℝ :=
  ∫ b, gaussianLikelihood b (Adv b) σ * Real.exp (-‖b‖^2 / 2) ∂volume

/-- The success probability of a quantum adversary. -/
noncomputable def success_prob_quantum (Adv : QuantumAdversary n) (Ω_k : Set (Matrix n n ℝ)) (σ : ℝ) : ℝ :=
  ∫ b, (∫ A in Ω_k, Adv b A * gaussianLikelihood b A σ ∂μ) * Real.exp (-‖b‖^2 / 2) ∂volume

/-- Normalization factor for the Gaussian prior. -/
noncomputable def normalizationFactor (n : Type*) [Fintype n] : ℝ :=
  (2 * Real.pi) ^ (- (Fintype.card n : ℝ) / 2)

/-- The normalized success probability of a classical adversary. -/
noncomputable def success_prob_classical_norm (Adv : ClassicalAdversary n) (Ω_k : Set (Matrix n n ℝ)) (σ : ℝ) : ℝ :=
  normalizationFactor n * success_prob_classical Adv Ω_k σ

/-- The normalized success probability of a quantum adversary. -/
noncomputable def success_prob_quantum_norm (Adv : QuantumAdversary n) (Ω_k : Set (Matrix n n ℝ)) (σ : ℝ) : ℝ :=
  normalizationFactor n * success_prob_quantum μ Adv Ω_k σ

/-- The success probability of a classical adversary, constrained to Ω_k. -/
noncomputable def success_prob_classical' (Adv : ClassicalAdversary n) (Ω_k : Set (Matrix n n ℝ)) (σ : ℝ) : ℝ :=
  normalizationFactor n * ∫ b, (Ω_k.indicator (fun A => gaussianLikelihood b A σ) (Adv b)) * Real.exp (-‖b‖^2 / 2) ∂volume

-- ============================================================================
-- §2  NORM CORRECTION: L∞ → L2
-- ============================================================================

/-
The Pi norm on (n → ℝ) is L∞ (sup norm), NOT L2.
gaussianLikelihood uses ‖A *ᵥ b‖ which is L∞.
gaussianLikelihood_correct wraps in WithLp 2 for the true L2 norm.
Python uses np.linalg.norm (L2), so the corrected version matches.
-/

/-- Pi norm on (Fin 2 → ℝ) is L∞: ‖(1,1)‖ = 1, not √2. -/
theorem pi_norm_is_Linf : (let v : Fin 2 → ℝ := fun _ => 1; ‖v‖ = 1) := by
  simp [Pi.norm_def, Finset.sup_const]

/-- The Laplacian applied to b is the projection of b onto W⊥.
    This is the core geometric identity: Δ_W b = P_{W⊥} b.
    Python: encrypt() puts message in ker(Δ), noise in im(Δ);
    decrypt = P_harmonic @ ciphertext recovers message. -/
lemma laplacian_apply (W : Submodule ℝ (EuclideanSpace ℝ n)) [W.HasOrthogonalProjection] (b : EuclideanSpace ℝ n) :
  _root_.laplacian W *ᵥ b = (Submodule.orthogonalProjection W.orthogonal) b := by
    unfold _root_.laplacian;
    ext i;
    simp +decide [ Matrix.one_apply, Matrix.mulVec, dotProduct ];
    simp +decide [ Matrix.toLin', LinearMap.toMatrix_apply ];
    have h_star_proj : W.starProjection b i = ∑ x, W.starProjection (EuclideanSpace.single x 1) i * b x := by
      have h_star_proj : W.starProjection b = ∑ x, b x • W.starProjection (EuclideanSpace.single x 1) := by
        convert ( W.starProjection ).pi_apply_eq_sum_univ b;
        aesop;
      rw [ h_star_proj, Finset.sum_apply, Finset.sum_congr rfl ] ; intros ; simp +decide [ mul_comm ];
    simp +decide [ h_star_proj, sub_mul, Finset.sum_sub_distrib ]

/-- The corrected Gaussian likelihood using L2 norm (matches Python's np.linalg.norm). -/
noncomputable def gaussianLikelihood_correct (b : EuclideanSpace ℝ n) (A : Matrix n n ℝ) (σ : ℝ) : ℝ :=
  Real.exp (- (‖(WithLp.equiv 2 (n → ℝ)).symm (A *ᵥ b)‖)^2 / (2 * σ^2))

/-- The corrected likelihood matches the noise model for Laplacians:
    L(b | Δ_W, σ) = exp(-‖P_{W⊥} b‖² / 2σ²). -/
lemma likelihood_correct_of_laplacian (b : EuclideanSpace ℝ n) (W : Submodule ℝ (EuclideanSpace ℝ n)) [W.HasOrthogonalProjection] (σ : ℝ) :
  gaussianLikelihood_correct b (_root_.laplacian W) σ = Real.exp (- ‖(Submodule.orthogonalProjection W.orthogonal) b‖^2 / (2 * σ^2)) := by
  rw [gaussianLikelihood_correct]
  congr 3
  rw [laplacian_apply]
  simp only [WithLp.equiv_symm_apply]
  simp +decide [ Norm.norm ]

-- ============================================================================
-- §3  Ω_k STRUCTURE: NONEMPTY AND INFINITE
-- ============================================================================

/-- Ω k is a subset of the set of all Laplacians. -/
theorem Ω_subset_LaplacianSpace (k : ℕ) :
  Ω k ⊆ { A | ∃ W : Submodule ℝ (EuclideanSpace ℝ n), ∃ h : W.HasOrthogonalProjection, A = @laplacian n _ _ W h } := by
    intro A hA;
    cases hA ; aesop

/-- There exists a subspace of dimension k if k ≤ n. -/
lemma exists_subspace_dim_k (k : ℕ) (hk : k ≤ Fintype.card n) :
  ∃ W : Submodule ℝ (EuclideanSpace ℝ n), Module.finrank ℝ W = k := by
    obtain ⟨s, hs⟩ : ∃ s : Finset n, s.card = k := by
      have := Finset.exists_subset_card_eq hk; tauto;
    refine' ⟨ Submodule.span ℝ ( Set.range ( fun i : s => EuclideanSpace.single ( i : n ) ( 1 : ℝ ) ) ), _ ⟩;
    rw [ finrank_span_eq_card ] ; aesop;
    refine' Fintype.linearIndependent_iff.2 _;
    intro g hg i; replace hg := congr_fun hg i; simp_all +decide [ Finset.sum_apply, EuclideanSpace.single_apply ] ;
    rw [ Finset.sum_apply, Finset.sum_eq_single i ] at hg <;> aesop

/-- Ω k is nonempty if k ≤ n.
    Python: grassmannian_laplacians(d, k) always returns results when k ≤ d. -/
theorem Ω_k_nonempty (k : ℕ) (hk : k ≤ Fintype.card n) : (@Ω n _ _ k).Nonempty := by
  obtain ⟨ W, hW ⟩ := exists_subspace_dim_k k hk;
  refine' ⟨ _, W, hW, inferInstance, rfl ⟩

/-- Existence of linearly independent u, v and a (k-1)-dimensional subspace W
    disjoint from span{u, v}. Used to construct the parameterized family W(t). -/
lemma exists_vectors_and_subspace (k : ℕ) (h1 : 1 ≤ k) (h2 : k < Fintype.card n) :
  ∃ u v : EuclideanSpace ℝ n, ∃ W : Submodule ℝ (EuclideanSpace ℝ n),
    LinearIndependent ℝ ![u, v] ∧
    Module.finrank ℝ W = k - 1 ∧
    Disjoint (Submodule.span ℝ (Set.range ![u, v])) W := by
      obtain ⟨W, hW⟩ : ∃ W : Submodule ℝ (EuclideanSpace ℝ n), Module.finrank ℝ W = k - 1 ∧ W ≠ ⊤ := by
        obtain ⟨W, hW⟩ : ∃ W : Submodule ℝ (EuclideanSpace ℝ n), Module.finrank ℝ W = k - 1 := by
          apply exists_subspace_dim_k; exact Nat.sub_le_of_le_add (by linarith);
        refine' ⟨ W, hW, _ ⟩;
        contrapose! h2; aesop;
      obtain ⟨u, hu⟩ : ∃ u : EuclideanSpace ℝ n, u ∉ W := by
        exact not_forall.mp fun h => hW.2 <| eq_top_iff.mpr fun x _ => h x;
      obtain ⟨v, hv⟩ : ∃ v : EuclideanSpace ℝ n, v ∉ W ⊔ Submodule.span ℝ {u} := by
        by_cases h_top : W ⊔ Submodule.span ℝ {u} = ⊤;
        · have := Submodule.finrank_sup_add_finrank_inf_eq W ( Submodule.span ℝ { u } );
          rw [ h_top, finrank_top ] at this;
          rw [ finrank_span_singleton ] at this <;> aesop;
        · exact not_forall.mp fun h => h_top <| eq_top_iff.mpr fun x _ => h x;
      refine' ⟨ u, v, W, _, _, _ ⟩ <;> simp_all +decide [ Submodule.disjoint_def ];
      · rw [ linearIndependent_fin2 ];
        refine' ⟨ _, _ ⟩ <;> contrapose! hv <;> simp_all +decide [ Submodule.mem_sup, Submodule.mem_span_singleton ];
        rcases hv with ⟨ a, rfl ⟩ ; exact ⟨ 0, W.zero_mem, a⁻¹, by simp +decide [ show a ≠ 0 by aesop ] ⟩ ;
      · intro x hx hxW; contrapose! hv; simp_all +decide [ Submodule.mem_sup, Submodule.mem_span_pair ] ;
        obtain ⟨ a, b, rfl ⟩ := hx;
        by_cases ha : a = 0;
        · simp_all +decide [ Submodule.mem_span_singleton ];
          exact False.elim ( hu ( by simpa [ hv.1 ] using W.smul_mem ( b⁻¹ ) hxW ) );
        · refine' ⟨ a⁻¹ • ( a • v + b • u ), _, -a⁻¹ • b • u, _, _ ⟩ <;> simp_all +decide [ Submodule.smul_mem, Submodule.add_mem_iff_right ];
          convert W.smul_mem ( a⁻¹ ) hxW using 1 ; simp +decide [ ha, smul_smul, add_smul ]

/-- Construction of a family of k-dimensional subspaces parameterized by t ∈ ℝ:
    W(t) = span{u + t·v} ⊕ W₀
    This gives an injection ℝ ↪ Gr(k,n), proving Ω_k is uncountably infinite. -/
def subspace_construction (u v : EuclideanSpace ℝ n) (W : Submodule ℝ (EuclideanSpace ℝ n)) (t : ℝ) : Submodule ℝ (EuclideanSpace ℝ n) :=
  Submodule.span ℝ {u + t • v} ⊔ W

/-- The constructed subspace W(t) has dimension k. -/
lemma subspace_construction_dim (k : ℕ) (h1 : 1 ≤ k) (u v : EuclideanSpace ℝ n) (W : Submodule ℝ (EuclideanSpace ℝ n))
  (h_indep : LinearIndependent ℝ ![u, v])
  (h_dim_W : Module.finrank ℝ W = k - 1)
  (h_disj : Disjoint (Submodule.span ℝ (Set.range ![u, v])) W)
  (t : ℝ) :
  Module.finrank ℝ (subspace_construction u v W t) = k := by
    have h_dim_sum : Module.finrank ℝ (↥(Submodule.span ℝ {u + t • v} ⊔ W)) = Module.finrank ℝ (↥(Submodule.span ℝ {u + t • v})) + Module.finrank ℝ (↥W) := by
      rw [ ← Submodule.finrank_sup_add_finrank_inf_eq ];
      simp +zetaDelta at *;
      refine' eq_bot_iff.mpr fun x hx => _;
      simp_all +decide [ Submodule.disjoint_def, Submodule.mem_span_singleton ];
      rcases hx with ⟨ ⟨ a, rfl ⟩, hx ⟩;
      convert h_disj _ _ hx using 1;
      exact Submodule.mem_span_pair.mpr ⟨ a * t, a, by ext; simp +decide ; ring ⟩;
    by_cases hu : u + t • v = 0 <;> simp_all +decide [ Submodule.finrank_eq_zero ];
    · have := Fintype.linearIndependent_iff.mp h_indep;
      specialize this ( fun i => if i = 0 then 1 else t ) ; simp_all +decide [ Fin.forall_fin_two ];
    · convert h_dim_sum using 1;
      rw [ finrank_span_singleton ] <;> aesop

/-- The subspace construction t ↦ W(t) is injective.
    CONSEQUENCE: Ω_k contains uncountably many distinct Laplacians.
    This is the key hardness lemma — the adversary's search space is not enumerable. -/
lemma subspace_construction_injective (u v : EuclideanSpace ℝ n) (W : Submodule ℝ (EuclideanSpace ℝ n))
  (h_indep : LinearIndependent ℝ ![u, v])
  (h_disj : Disjoint (Submodule.span ℝ (Set.range ![u, v])) W) :
  Function.Injective (subspace_construction u v W) := by
    intro t1 t2 h_eq;
    have h_t_eq : u + t1 • v ∈ Submodule.span ℝ {u + t2 • v} ⊔ W := by
      unfold subspace_construction at h_eq;
      exact h_eq ▸ Submodule.mem_sup_left ( Submodule.subset_span ( Set.mem_singleton _ ) );
    rw [ Submodule.mem_sup ] at h_t_eq;
    obtain ⟨y, hy, z, hz, h_eq⟩ := h_t_eq
    have hz_zero : z = 0 := by
      have hz_zero : z ∈ Submodule.span ℝ (Set.range ![u, v]) := by
        rw [ Submodule.mem_span_singleton ] at hy;
        obtain ⟨ a, rfl ⟩ := hy;
        rw [ show z = ( 1 - a ) • u + ( t1 - a * t2 ) • v by ext x; have := congr_fun h_eq x; norm_num at *; linarith ];
        exact Submodule.add_mem _ ( Submodule.smul_mem _ _ ( Submodule.subset_span ( Set.mem_range_self 0 ) ) ) ( Submodule.smul_mem _ _ ( Submodule.subset_span ( Set.mem_range_self 1 ) ) );
      exact h_disj.le_bot ⟨ hz_zero, hz ⟩;
    rw [ Submodule.mem_span_singleton ] at hy;
    rw [ Fintype.linearIndependent_iff ] at h_indep;
    specialize h_indep ( fun i => if i = 0 then hy.choose - 1 else hy.choose * t2 - t1 ) ; simp_all +decide [ Fin.forall_fin_two, sub_eq_iff_eq_add ];
    have := hy.choose_spec; simp_all +decide [ ← eq_sub_iff_add_eq', smul_smul ] ;
    have := h_indep ( by ext x; have := congr_fun this x; norm_num at *; linarith ) ; aesop;

/-- The Laplacian map W ↦ Δ_W is injective on subspaces.
    Combined with subspace_construction_injective, this gives:
    ℝ ↪ Gr(k,n) ↪ Ω_k  (uncountably many distinct Laplacians).
    STATUS: star projection steps need finishing (exact? holes). -/
theorem laplacian_injective (W1 W2 : Submodule ℝ (EuclideanSpace ℝ n))
  [h1 : W1.HasOrthogonalProjection] [h2 : W2.HasOrthogonalProjection] :
  laplacian W1 = laplacian W2 → W1 = W2 := by
    intro h_eq;
    unfold _root_.laplacian at h_eq;
    simp +zetaDelta at *;
    refine' le_antisymm _ _ <;> intro x hx <;> replace h_eq := LinearMap.congr_fun h_eq x <;> simp_all +decide [ Submodule.mem_orthogonal' ];
    · have h_proj_W1 : W1.starProjection x = x := by
        exact?;
      have h_proj_W2 : W2.starProjection x ∈ W2 := by
        exact?;
      grind;
    · have h_star_proj : W1.starProjection x = x := by
        rw [ h_eq, W2.starProjection_eq_self_iff.mpr hx ];
      exact?

-- ============================================================================
-- §4  OPTIMAL CLASSICAL ADVERSARY
-- ============================================================================

/-- The optimal classical adversary guesses W = span{b} (Bayes-optimal for k=1).
    Python: tsirelson.py optimal_classical_adversary() returns argmax likelihood. -/
noncomputable def optimal_classical_adversary (b : EuclideanSpace ℝ n) : Matrix n n ℝ :=
  if h : b = 0 then 0 else
  let W := Submodule.span ℝ {b}
  haveI : FiniteDimensional ℝ W := FiniteDimensional.span_singleton ℝ b
  haveI : W.HasOrthogonalProjection := Submodule.HasOrthogonalProjection.ofCompleteSpace W
  laplacian W

/-- The optimal adversary achieves likelihood 1 for non-zero b.
    This is because b ∈ span{b}, so P_{span{b}⊥}(b) = 0, giving exp(0) = 1.
    The adversary always guesses correctly — but only for this single observation.
    The hardness comes from the INTEGRATION over all b (the search space). -/
lemma optimal_adversary_likelihood_one (b : EuclideanSpace ℝ n) (hb : b ≠ 0) (σ : ℝ) :
  gaussianLikelihood b (optimal_classical_adversary b) σ = 1 := by
    unfold gaussianLikelihood optimal_classical_adversary;
    split_ifs ; simp_all +decide [ Submodule.HasOrthogonalProjection ];
    rw [ laplacian_apply, Submodule.orthogonalProjection_mem_subspace_orthogonalComplement_eq_zero ] ; aesop;
    simp +decide [ Submodule.mem_orthogonal' ]

-- ============================================================================
-- §5  ANALYSIS TOOLS
-- ============================================================================

/-- Gaussian integrand factors over coordinates:
    exp(-‖x‖²/2) = ∏ᵢ exp(-xᵢ²/2).
    This enables product-form integration bounds for success probability. -/
lemma gaussian_integrand_factorization (x : EuclideanSpace ℝ n) :
  Real.exp (-‖x‖^2 / 2) = ∏ i : n, Real.exp (-(x i)^2 / 2) := by
    rw [ ← Real.exp_sum, EuclideanSpace.norm_eq ];
    simp +decide [ ← Finset.sum_div, Real.sq_sqrt ( Finset.sum_nonneg fun _ _ => sq_nonneg _ ) ]

end -- noncomputable section

