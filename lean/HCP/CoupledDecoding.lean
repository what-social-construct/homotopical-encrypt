module

public import HCP.CoupledGeometry
public import HCP.CoupledCVP
public import HCP.CoupledRational
public import Sheaf.CoefficientRecovery

@[expose] public section

/-!
# Exact rational refinement of harmonic-lattice decoding

The executable rational inverse and its integer-coordinate test implement the
original partial decoder on every rational observed cochain, including inputs
that were not generated by encryption. A successful result means precisely
that harmonic projection is the corresponding point of the existing coupled
graph lattice. Failure means that projection lies outside the intrinsic
integral harmonic lattice; the fixed coupled profile has no saturation gap.

These are exact mathematical and algorithmic correspondence statements. They
make no complexity, ciphertext privacy, key-management or security claim.
-/

set_option autoImplicit false

open scoped BigOperators

noncomputable section

namespace HomotopicalEncryption.HCP.CoupledDecoding

open Sheaf CellularSheaf HCPCoupledFamily

variable {Row Col : Type} [Fintype Row] [Fintype Col]
  [DecidableEq Row] [DecidableEq Col]

/-- The actual rational check succeeds exactly at an integral recovered
coefficient vector, for arbitrary rational observations. -/
theorem rational_decode_eq_some_iff (B : Matrix Row Col ℤ)
    (v : CoupledRational.RationalCochain Row Col) (z : Col → ℤ) :
    CoupledRational.decodeCoefficients B v = some z ↔
      ∀ c, CoupledRational.recoverMessage B v c = (z c : ℚ) := by
  unfold CoupledRational.decodeCoefficients
  split_ifs with integral
  · rw [Option.some.injEq]
    constructor
    · intro coefficients c
      exact (Rat.coe_int_num_of_den_eq_one (integral c)).symm.trans
        (congrArg (fun n : ℤ => (n : ℚ)) (congrFun coefficients c))
    · intro coefficients
      funext c
      simpa using congrArg Rat.num (coefficients c)
  · constructor
    · intro impossible
      cases impossible
    · intro coefficients
      exact (integral (fun c => by rw [coefficients c]; simp)).elim

/-- The rational inverse reads the same real information coordinates as the
original private Hodge-coordinate inverse. -/
theorem information_inverse_realize (B : Matrix Row Col ℤ)
    (v : CoupledRational.RationalCochain Row Col) (c : Col) :
    information ((CoupledTransport.nativeEquiv B).symm (CoupledRational.realize v)) c =
      (CoupledRational.recoverMessage B v c : ℝ) := by
  rw [← CoupledRational.realize_inverseMatrix_mulVec]
  rfl

/-- Projection of any rational observation reaches the selected integer point
exactly when its rationally recovered coefficients are that integer vector. -/
theorem projection_eq_point_iff_recoverMessage (B : Matrix Row Col ℤ)
    (v : CoupledRational.RationalCochain Row Col) (z : Col → ℤ) :
    (sheaf B).harmonicOneProjection (CoupledRational.realize v) =
        ((CoupledCVP.harmonicLatticePresentation B).point z).1 ↔
      ∀ c, CoupledRational.recoverMessage B v c = (z c : ℚ) := by
  rw [CoupledGeometry.harmonicOneProjection_eq_graphVector_inverse]
  change graphVector B _ = WithLp.toLp 2 (CVP.latticeVector (CoupledCVP.graphLattice B) z) ↔ _
  rw [CoupledCVP.latticeVector_eq_graphVector]
  constructor
  · intro projected c
    have coordinate := congrFun (graphVector_injective B projected) c
    rw [information_inverse_realize] at coordinate
    exact_mod_cast coordinate
  · intro coefficients
    apply congrArg (graphVector B)
    funext c
    rw [information_inverse_realize, coefficients c]
    norm_cast

/-- The finite rational algorithm refines the original harmonic-lattice
partial decoder on every rational input, not only generated ciphertexts. -/
theorem decodeCoefficients_realize (B : Matrix Row Col ℤ)
    (v : CoupledRational.RationalCochain Row Col) :
    (CoupledCVP.harmonicLatticePresentation B).decodeCoefficients
        (CoupledRational.realize v) =
      CoupledRational.decodeCoefficients B v := by
  apply Option.ext
  intro z
  rw [HarmonicLatticePresentation.decodeCoefficients_eq_some_iff,
    projection_eq_point_iff_recoverMessage, rational_decode_eq_some_iff]

/-- For the coupled presentation, rejection is exactly failure of intrinsic
integral harmonic-lattice membership after projection. -/
theorem decode_eq_none_iff_projection_not_mem_lattice (B : Matrix Row Col ℤ)
    (v : CoupledRational.RationalCochain Row Col) :
    CoupledRational.decodeCoefficients B v = none ↔
      (sheaf B).harmonicOneProjection (CoupledRational.realize v) ∉
        (integralStructure B).harmonicOneLattice := by
  rw [← decodeCoefficients_realize,
    HarmonicLatticePresentation.decodeCoefficients_eq_none_iff,
    HCPCoupledFamily.mem_harmonicOneLattice_iff]
  change (¬ ∃ z : Col → ℤ,
    (sheaf B).harmonicOneProjection (CoupledRational.realize v) =
      WithLp.toLp 2 (CVP.latticeVector (CoupledCVP.graphLattice B) z)) ↔ _
  simp_rw [CoupledCVP.latticeVector_eq_graphVector]

/-- On an arbitrary integer cochain, the decoder accepts exactly the original
native Hodge-encryption language with the returned integer message. The exact
and coexact openings are integral; no magnitude or sampling restriction is
imposed on them. -/
theorem decode_integer_eq_some_iff_observed (B : Matrix Row Col ℤ)
    (b : Index Row Col → ℤ) (z : Col → ℤ) :
    CoupledRational.decodeCoefficients B (fun p => (b p : ℚ)) = some z ↔
      ∃ (a : ℤ) (u : Row → ℤ), HCPCoupledEncoding.integerObserved B z a u = b := by
  constructor
  · intro accepted
    have coefficients := (rational_decode_eq_some_iff B _ z).mp accepted
    let v : CoupledRational.RationalCochain Row Col := fun p => (b p : ℚ)
    let q := (CoupledTransport.nativeEquiv B).symm (CoupledRational.realize v)
    let a : ℤ := b ⟨none, 0⟩
    let u : Row → ℤ := fun r => b ⟨some (.inr r), 0⟩ - ∑ c, B r c * z c
    have information_eq (c : Col) : information q c = (z c : ℝ) := by
      change information ((CoupledTransport.nativeEquiv B).symm
        (CoupledRational.realize v)) c = _
      rw [information_inverse_realize, coefficients c]
      norm_cast
    have assembled : CoupledTransport.nativeEquiv B q = CoupledRational.realize v :=
      (CoupledTransport.nativeEquiv B).apply_symm_apply _
    have exact_eq : exactCoord q = (a : ℝ) := by
      have coordinate := congrArg exactCoord assembled
      change exactCoord (CoupledTransport.nativeLinear B q) = (a : ℝ) at coordinate
      exact coordinate
    have parity_eq (r : Row) : parity q r = (u r : ℝ) := by
      have coordinate := congrArg (fun t : C1 Row Col => parity t r) assembled
      change (∑ c, (B r c : ℝ) * information q c) + parity q r =
        (b ⟨some (.inr r), 0⟩ : ℝ) at coordinate
      simp_rw [information_eq] at coordinate
      change parity q r = ((b ⟨some (.inr r), 0⟩ - ∑ c, B r c * z c : ℤ) : ℝ)
      push_cast
      exact eq_sub_of_add_eq' coordinate
    have coordinates_eq :
        CoupledTransport.coordinates (a : ℝ) (fun c => (z c : ℝ))
          (fun r => (u r : ℝ)) = q := by
      rw [← exact_eq]
      conv_lhs => arg 2; ext c; rw [← information_eq]
      conv_lhs => arg 3; ext r; rw [← parity_eq]
      exact CoupledTransport.coordinates_eta q
    have observed_eq : (HCPCoupledEncoding.sample B z a u).observed =
        CoupledRational.realize v := by
      rw [← CoupledTransport.nativeEquiv_coordinates_eq_observed, coordinates_eq]
      exact assembled
    refine ⟨a, u, ?_⟩
    funext p
    have coordinate := congrArg (fun t : C1 Row Col => t p) observed_eq
    rw [← HCPCoupledEncoding.integerObserved_cast_eq_observed] at coordinate
    change (HCPCoupledEncoding.integerObserved B z a u p : ℝ) = (b p : ℝ) at coordinate
    exact_mod_cast coordinate
  · rintro ⟨a, u, observed⟩
    rw [← observed]
    exact CoupledRational.decodeCoefficients_sampleVector B z a u

end HomotopicalEncryption.HCP.CoupledDecoding
