module

public import Sheaf.HarmonicCVPPromise
public import Sheaf.HCPFiniteKeyGeometry

@[expose] public section

/-!
# The explicit harmonic lattice of the finite keyed sheaf family

The complementary harmonic coordinate unit in each block is an integral
lattice generator. The resulting presented lattice spans the actual harmonic
subspace of each keyed cellular sheaf.
-/

set_option autoImplicit false

noncomputable section

namespace HomotopicalEncryption.HCP.FiniteKeyCVP

open HomotopicalEncryption.Sheaf
open HomotopicalEncryption.Sheaf.HCPFiniteKeyFamily
open HomotopicalEncryption.Sheaf.CellularSheaf
open HomotopicalEncryption.Sheaf.HCPFiniteKeyGeometry
open scoped BigOperators RealInnerProductSpace

variable (n : ℕ)

/-- Columns are the complementary harmonic coordinate units. -/
def harmonicBasis (key : Key n) : Matrix (Index n) (Fin n) ℝ :=
  fun p i => harmonicUnit n key i p

/-- The keyed integral harmonic lattice, presented by its block units. -/
def harmonicLattice (key : Key n) : CVP.ExplicitLattice (Index n) (Fin n) where
  basis := harmonicBasis n key
  basis_injective := by
    apply Matrix.mulVec_injective_iff.mpr
    have hli :=
      (harmonicUnit_linearIndependent n key).map'
        (WithLp.linearEquiv 2 ℝ (Index n → ℝ)).toLinearMap
        (by simp)
    change LinearIndependent ℝ
      (fun i : Fin n => (harmonicUnit n key i).ofLp)
    exact hli

/-- Integer coefficient vectors give integer combinations of harmonic units. -/
theorem harmonicLatticeVector_eq_sum (key : Key n) (z : Fin n → ℤ) :
    WithLp.toLp 2 (CVP.latticeVector (harmonicLattice n key) z) =
      ∑ i : Fin n, (z i) • harmonicUnit n key i := by
  apply PiLp.ext
  intro p
  simp [CVP.latticeVector, harmonicLattice, harmonicBasis,
    Matrix.mulVec, dotProduct, mul_comm]

/-- A full-rank integral presentation of the operative harmonic lattice. -/
def harmonicLatticePresentation (key : Key n) :
    HarmonicLatticePresentation (integralStructure n key) (Fin n) where
  lattice := harmonicLattice n key
  latticeVector_mem z := by
    rw [harmonicLatticeVector_eq_sum]
    apply AddSubgroup.sum_mem
    intro i _
    exact (integralStructure n key).harmonicOneLattice.zsmul_mem
      (message n key i).2 (z i)
  realSpan_eq_harmonic := by
    have hrange :
        LinearMap.range
          ((WithLp.linearEquiv 2 ℝ (Index n → ℝ)).symm.toLinearMap.comp
            (Matrix.mulVecLin (harmonicLattice n key).basis)) =
          Submodule.span ℝ (Set.range (harmonicUnit n key)) := by
      rw [LinearMap.range_comp, Matrix.range_mulVecLin,
        Submodule.map_span, ← Set.range_comp]
      congr 1
    exact hrange.trans
      (harmonicSubspace_eq_span_harmonicUnit n key).symm

/-- A supplied correct CVP oracle recovers a generated cochain's harmonic
message when the keyed presentation is also supplied. -/
theorem correct_cvp_oracle_recovers_generated
    (key : Key n)
    (O : CVP.Oracle (Index n) (Fin n))
    (hO : CVP.OracleCorrect O)
    (z : Fin n → ℤ) (opening : HodgeNoise (sheaf n key)) :
    O (harmonicLatticePresentation n key).lattice
        ((harmonicLatticePresentation n key).encrypt z opening).observed =
      ((harmonicLatticePresentation n key).point z).1 :=
  (harmonicLatticePresentation n key).correct_cvp_oracle_recovers_encrypt
    O hO z opening

/-- The coefficient vector with one nonzero entry selects a block unit. -/
def unitCoefficients (i : Fin n) : Fin n → ℤ :=
  fun j => if j = i then 1 else 0

theorem point_unitCoefficients (key : Key n) (i : Fin n) :
    ((harmonicLatticePresentation n key).point (unitCoefficients n i)).1 =
      harmonicUnit n key i := by
  change WithLp.toLp 2
      (CVP.latticeVector (harmonicLattice n key) (unitCoefficients n i)) = _
  rw [harmonicLatticeVector_eq_sum]
  simp [unitCoefficients]

/-- The original finite-family sample is generated by the explicit harmonic
lattice presentation with its block-unit coefficient vector. -/
theorem sample_eq_encrypt_unit (key : Key n) (i : Fin n) :
    sample n key i =
      (harmonicLatticePresentation n key).encrypt
        (unitCoefficients n i) (opening n key i) := by
  have hm : message n key i =
      (harmonicLatticePresentation n key).point (unitCoefficients n i) := by
    apply Subtype.ext
    exact (point_unitCoefficients n key i).symm
  change
    ({ message := message n key i, opening := opening n key i } :
      HodgeEncryptedCochain (integralStructure n key)) =
      { message := (harmonicLatticePresentation n key).point (unitCoefficients n i),
        opening := opening n key i }
  rw [hm]

/-- Supplying the actual keyed lattice to a correct CVP oracle recovers the
message of the original finite-family sample. -/
theorem correct_cvp_oracle_recovers_sample
    (key : Key n) (i : Fin n)
    (O : CVP.Oracle (Index n) (Fin n)) (hO : CVP.OracleCorrect O) :
    O (harmonicLatticePresentation n key).lattice (sample n key i).observed =
      (sample n key i).message.1 := by
  rw [sample_eq_encrypt_unit]
  exact correct_cvp_oracle_recovers_generated n key O hO
    (unitCoefficients n i) (opening n key i)

end HomotopicalEncryption.HCP.FiniteKeyCVP
