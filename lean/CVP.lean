import Mathlib

/-
  Generic explicit-lattice CVP vocabulary.

  Provenance/scope label:
  this module formalizes the standard Closest Vector Problem (CVP) interface
  used as an external hardness/comparison problem. It is not an original
  hcrypt theorem claiming CVP hardness from first principles.

  This file owns the known-lattice side of the security story. It defines the
  problem objects and oracle-correctness predicates used by `Hardness.lean`.

  Important scope: CVP hardness is an external complexity assumption. Lean can
  define CVP instances, solutions, and reductions involving CVP; it does not
  prove that no efficient CVP solver exists.
-/

set_option linter.mathlibStandardSet false
set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-- A presented lattice, represented by an explicit basis/generator matrix. -/
abbrev ExplicitLattice (n : Type) [Fintype n] (R : Type) [CommRing R] :=
  Matrix n n R

/-- A CVP instance is a presented lattice together with a target vector. -/
def CVP_Instance (n : Type) [Fintype n] (R : Type) [CommRing R] :=
  ExplicitLattice n R × (n → R)

/-- A vector lies in the explicit lattice generated by `B`. -/
def InExplicitLattice {n : Type} [Fintype n] {R : Type} [CommRing R]
  (B : ExplicitLattice n R) (v : n → R) : Prop :=
  ∃ x, Matrix.mulVec B x = v

/--
A genuine CVP answer on an explicit lattice: the answer is a lattice vector
closest to the target among all vectors in the lattice generated by `B`.
-/
def IsClosestLatticeVector
  {n : Type} [Fintype n] {R : Type}
  [CommRing R] [NormedRing R] [NormedAddCommGroup R]
  (B : ExplicitLattice n R) (t v : n → R) : Prop :=
  InExplicitLattice B v ∧
  ∀ w, InExplicitLattice B w → dist t v ≤ dist t w

/-- A candidate solution to a CVP instance. -/
def CVPSolution
  {n : Type} [Fintype n] {R : Type}
  [CommRing R] [NormedRing R] [NormedAddCommGroup R]
  (I : CVP_Instance n R) (v : n → R) : Prop :=
  IsClosestLatticeVector I.1 I.2 v

/-- An oracle for explicit known-lattice CVP instances. -/
def CVP_Oracle (n : Type) [Fintype n] (R : Type) [CommRing R] :=
  ExplicitLattice n R → (n → R) → (n → R)

/--
Minimal correctness contract for an oracle on explicit lattices: it returns a
vector in the presented lattice.
-/
def LatticeOracleCorrect {n : Type} [Fintype n] {R : Type} [CommRing R]
  (O : CVP_Oracle n R) : Prop :=
  ∀ (B : ExplicitLattice n R) (t : n → R), InExplicitLattice B (O B t)

/-- Full correctness contract for a CVP oracle on explicitly presented lattices. -/
def CVPOracleCorrect
  {n : Type} [Fintype n] {R : Type}
  [CommRing R] [NormedRing R] [NormedAddCommGroup R]
  (O : CVP_Oracle n R) : Prop :=
  ∀ (B : ExplicitLattice n R) (t : n → R), IsClosestLatticeVector B t (O B t)

/-- A solver is correct when it returns a CVP solution for every instance. -/
def CVPSolverCorrect
  {n : Type} [Fintype n] {R : Type}
  [CommRing R] [NormedRing R] [NormedAddCommGroup R]
  (O : CVP_Oracle n R) : Prop :=
  ∀ I : CVP_Instance n R, CVPSolution I (O I.1 I.2)

/-- The oracle and instance-based formulations of CVP correctness agree. -/
theorem cvpSolverCorrect_iff_oracleCorrect
  {n : Type} [Fintype n] {R : Type}
  [CommRing R] [NormedRing R] [NormedAddCommGroup R]
  (O : CVP_Oracle n R) :
  CVPSolverCorrect O ↔ CVPOracleCorrect O := by
  constructor
  · intro h B t
    exact h (B, t)
  · intro h I
    exact h I.1 I.2

/--
External CVP hardness assumption schema.

The predicate `Efficient` is supplied by the surrounding complexity model. Lean
uses this as an assumption boundary: it states that no efficient oracle solves
CVP on all explicitly presented lattices.
-/
def CVPHardnessAssumption
  {n : Type} [Fintype n] {R : Type}
  [CommRing R] [NormedRing R] [NormedAddCommGroup R]
  (Efficient : CVP_Oracle n R → Prop) : Prop :=
  ¬ ∃ O : CVP_Oracle n R, Efficient O ∧ CVPOracleCorrect O

/-- The zero oracle satisfies the minimal explicit-lattice contract. -/
theorem zero_lattice_oracle_correct
  {n : Type} [Fintype n] [DecidableEq n]
  {R : Type} [Field R] [DecidableEq R] :
  LatticeOracleCorrect (fun (_B : ExplicitLattice n R) (_t : n → R) => 0) := by
  intro B _t
  exact ⟨0, by simp⟩
