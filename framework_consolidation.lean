      obtain ⟨Δ₁, h₁, h₁_ne_zero⟩ := h_base;
      use Δ₁, 1; simp [h₁_ne_zero];
      exact ⟨ h₁, h₁_ne_zero.1, fun h => h₁_ne_zero.2 <| by simpa [ is_harmonic ] using h ⟩

