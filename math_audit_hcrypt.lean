/-
Definition of Grothendieck fibration and homotopy equivalence. A morphism f: U -> V is Cartesian if it satisfies the universal property. A functor p is a Grothendieck fibration if it has Cartesian lifts. Two fibrations are homotopy equivalent if they are equivalent as objects in the category of fibrations over B.
-/
universe u v

open CategoryTheory

variable {E B : Type u} [Category.{v} E] [Category.{v} B]

/-- A morphism f : U ⟶ V in E is p-Cartesian if for every g : W ⟶ V in E and h : p(W) ⟶ p(U)
    such that p(g) = h ≫ p(f), there exists a unique k : W ⟶ U such that p(k) = h and k ≫ f = g. -/
def IsCartesianMorphism (p : E ⥤ B) {U V : E} (f : U ⟶ V) : Prop :=
  ∀ (W : E) (g : W ⟶ V) (h : p.obj W ⟶ p.obj U),
    p.map g = h ≫ p.map f →
    ∃! k : W ⟶ U, p.map k = h ∧ k ≫ f = g

/-- A functor p : E ⥤ B is a Grothendieck fibration if for every V ∈ E and every morphism α : X ⟶ p(V) in B,
    there exists a p-Cartesian morphism f : U ⟶ V covering α. -/
class GrothendieckFibration (p : E ⥤ B) : Prop where
  has_cartesian_lifts : ∀ (V : E) (X : B) (α : X ⟶ p.obj V),
    ∃ (U : E) (h : p.obj U = X) (f : U ⟶ V),
      p.map f = eqToHom h ≫ α ∧ IsCartesianMorphism p f

/-- Two fibrations p : E ⥤ B and q : D ⥤ B are homotopy equivalent if there exist functors
    F : E ⥤ D and G : D ⥤ E over B (commuting with p and q) such that GF ≅ id and FG ≅ id. -/
def HomotopyEquivalent {D : Type u} [Category.{v} D] (p : E ⥤ B) (q : D ⥤ B) : Prop :=
  ∃ (F : E ⥤ D) (G : D ⥤ E),
    p = F ⋙ q ∧ q = G ⋙ p ∧
    Nonempty (G ⋙ F ≅ Functor.id D) ∧
    Nonempty (F ⋙ G ≅ Functor.id E)

/-
Definition of Sheaf Laplacian and Spectral Fingerprint. The Laplacian is a self-adjoint positive operator. The spectral fingerprint is the multiset of its eigenvalues. Two sheaves are spectrally equivalent if their fingerprints match.
-/
open scoped RealInnerProductSpace

variable {V : Type} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]

/-- The Laplacian operator Δ on the space of sheaf cochains.
    It is a self-adjoint positive semi-definite operator. -/
structure SheafLaplacian (V : Type) [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V] where
  Δ : V →ₗ[ℝ] V
  is_self_adjoint : LinearMap.IsSymmetric Δ
  is_positive : LinearMap.IsPositive Δ

/-- The spectral fingerprint of a sheaf is the multiset of eigenvalues of its Laplacian. -/
noncomputable def SpectralFingerprint (L : SheafLaplacian V) : Multiset ℝ :=
  let n := Module.finrank ℝ V
  let eigenvalues := L.is_self_adjoint.eigenvalues (by rfl : Module.finrank ℝ V = n)
  Multiset.map (fun i => eigenvalues i) (Finset.univ.val)

/-- Two sheaves are spectrally equivalent if they have the same spectral fingerprint. -/
def SpectrallyEquivalent (L1 L2 : SheafLaplacian V) : Prop :=
  SpectralFingerprint L1 = SpectralFingerprint L2

/-
Definition of a Wrapper type to create distinct copies of a type E, along with its Category instance.
-/
open CategoryTheory

variable {B : Type u} [Category.{v} B]

/-- A wrapper type to create distinct copies of E. -/
structure Wrapper (n : ℕ) (E : Type u) where
  val : E

instance (n : ℕ) (E : Type u) [Category.{v} E] : Category (Wrapper n E) :=
  InducedCategory.category Wrapper.val

instance (n : ℕ) (E : Type u) [Category.{v} E] : Category.{v} (Wrapper n E) :=
  InducedCategory.category Wrapper.val

/-
Definition of Fibration. A Fibration is a bundled functor that is a Grothendieck fibration.
-/
open CategoryTheory

variable {B : Type u} [Category.{v} B]

/-- A bundled Grothendieck fibration over a base category B. -/
structure Fibration (B : Type u) [Category.{v} B] where
  E : Type u
  [str : Category.{v} E]
  p : E ⥤ B
  [is_fib : GrothendieckFibration p]

attribute [instance] Fibration.str Fibration.is_fib

/-
Definition of FibrationCopy. It creates a new fibration using the Wrapper type, which is isomorphic to the original fibration. We leave the proof that it is a Grothendieck fibration to the ATP.
-/
open CategoryTheory

variable {B : Type u} [Category.{v} B]

/-- Construct a copy of a fibration tagged with a natural number. -/
def FibrationCopy (F : Fibration B) (n : ℕ) : Fibration B :=
  let E' := Wrapper n F.E
  let p' : E' ⥤ B := CategoryTheory.inducedFunctor Wrapper.val ⋙ F.p
  {
    E := E'
    p := p'
    is_fib := by
      constructor;
      intro V X α;
      obtain ⟨ U, hU, f, hf, hf' ⟩ := F.is_fib.has_cartesian_lifts V.val X α;
      refine' ⟨ ⟨ U ⟩, hU, _, _, _ ⟩;
      exact f;
      · exact hf;
      · exact?
  }

/-
Lemma stating that the copies created by FibrationCopy are homotopy equivalent to the original fibration.
-/
open CategoryTheory

variable {B : Type u} [Category.{v} B]

/-- The copies are homotopy equivalent to the original. -/
lemma copy_equivalent (F : Fibration B) (n : ℕ) : HomotopyEquivalent F.p (FibrationCopy F n).p := by
  constructor;
  swap;
  refine' { obj := _, map := _, map_id := _, map_comp := _ };
  exact fun x => ⟨ x ⟩;
  exact?;
  exact?;
  exact?;
  refine' ⟨ _, _, _, _, _ ⟩;
  exact CategoryTheory.inducedFunctor Wrapper.val;
  · exact?;
  · exact?;
  · refine' ⟨ _ ⟩;
    aesop;
  · exact ⟨ CategoryTheory.Iso.refl _ ⟩

/-
Definition of WrapperIndex type class and instance for Wrapper. This is used to distinguish Wrapper types with different indices.
-/
open CategoryTheory

variable {B : Type u} [Category.{v} B]

/-- A type class to recover the index n from Wrapper n E. -/
class WrapperIndex (T : Type u) where
  idx : ℕ

instance (n : ℕ) (E : Type u) : WrapperIndex (Wrapper n E) where
  idx := n

/-
Definition of a scalar Laplacian on ℝ.
-/
def ScalarLaplacian (c : ℝ) (hc : 0 ≤ c) : SheafLaplacian ℝ :=
  {
    Δ := c • LinearMap.id
    is_self_adjoint := by
      intro x y; simp +decide [ mul_comm, real_inner_comm ] ;
      ring
    is_positive := by
      constructor ; aesop;
      simp +decide [ inner_self_eq_norm_sq_to_K, hc ];
      exact fun x => by nlinarith [ mul_self_nonneg x ] ;
  }

/-
The kernel dimension of a scalar Laplacian with positive scalar is 0.
-/
lemma ScalarLaplacian_ker_dim (c : ℝ) (hc : 0 < c) :
  Module.finrank ℝ (LinearMap.ker (ScalarLaplacian c (le_of_lt hc)).Δ) = 0 := by
    rw [ LinearMap.ker_eq_bot.mpr ] <;> norm_num;
    exact fun x y hxy => by simpa [ hc.ne' ] using smul_right_injective ℝ hc.ne' hxy;

/-
The only eigenvalue of the scalar map `c • id` on `ℝ` is `c`.
-/
lemma scalar_map_eigenvalue_unique (c μ : ℝ) (h : Module.End.HasEigenvalue (c • (LinearMap.id : ℝ →ₗ[ℝ] ℝ)) μ) :
  μ = c := by
    simp_all +decide [ Module.End.HasUnifEigenvalue ];
    simp_all +decide [ Submodule.eq_bot_iff ];
    grind

/-
The 0-th eigenvalue of the scalar Laplacian on ℝ is c.
-/
lemma ScalarLaplacian_eigenvalue_zero (c : ℝ) (hc : 0 ≤ c) :
  (ScalarLaplacian c hc).is_self_adjoint.eigenvalues (Module.finrank_self ℝ) 0 = c := by
    -- Since the only eigenvalue of the scalar Laplacian on ℝ is c, we have that the 0-th eigenvalue is c.
    have h_eigenvalue : ∀ (μ : ℝ), Module.End.HasEigenvalue (c • LinearMap.id : ℝ →ₗ[ℝ] ℝ) μ → μ = c := by
      exact?;
    convert h_eigenvalue _ _;
    convert LinearMap.IsSymmetric.hasEigenvalue_eigenvalues _ _ _

/-
The spectral fingerprint of a scalar Laplacian is the singleton set containing the scalar.
-/
lemma ScalarLaplacian_fingerprint (c : ℝ) (hc : 0 ≤ c) :
  SpectralFingerprint (ScalarLaplacian c hc) = {c} := by
    -- By definition of spectral fingerprint, we know that it is equal to the multiset of eigenvalues of the Laplacian.
    simp [SpectralFingerprint];
    convert ScalarLaplacian_eigenvalue_zero c hc

/-
Definition of homotopy equivalence for Laplacians based on kernel dimension.
-/
def HomotopyEquivalentLaplacians {V : Type} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V] (L1 L2 : SheafLaplacian V) : Prop :=
  Module.finrank ℝ (LinearMap.ker L1.Δ) = Module.finrank ℝ (LinearMap.ker L2.Δ)

/-
There exist two SheafLaplacians that are homotopy equivalent (have the same kernel dimension) but not spectrally equivalent.
-/
theorem Spectrum_Not_Homotopy_Invariant :
  ∃ (L1 L2 : SheafLaplacian ℝ), HomotopyEquivalentLaplacians L1 L2 ∧ ¬ SpectrallyEquivalent L1 L2 := by
    refine' ⟨ _, _, _, _ ⟩;
    exact ScalarLaplacian 1 zero_le_one;
    exact ScalarLaplacian 2 zero_le_two;
    · exact Eq.symm ( by rw [ ScalarLaplacian_ker_dim 1 zero_lt_one, ScalarLaplacian_ker_dim 2 zero_lt_two ] );
    · unfold SpectrallyEquivalent; norm_num [ ScalarLaplacian_fingerprint ] ;

/-
Functors between a category and its wrapper.
-/
def ToWrapper (n : ℕ) (E : Type u) [Category.{v} E] : E ⥤ Wrapper n E where
  obj X := ⟨X⟩
  map f := f
  map_id := by intro X; rfl
  map_comp := by intro X Y Z f g; rfl

def FromWrapper (n : ℕ) (E : Type u) [Category.{v} E] : Wrapper n E ⥤ E where
  obj W := W.val
  map f := f
  map_id := by intro W; rfl
  map_comp := by intro W Y Z f g; rfl

/-
The copies created by FibrationCopy are homotopy equivalent to the original fibration.
-/
lemma copy_equivalent_thm (F : Fibration B) (n : ℕ) : HomotopyEquivalent F.p (FibrationCopy F n).p := by
  exact?

/-
The composition of the induced functor from the wrapper and the original fibration is a Grothendieck fibration.
-/
lemma FibrationCopy_is_Grothendieck (F : Fibration B) (n : ℕ) :
  GrothendieckFibration (CategoryTheory.inducedFunctor (Wrapper.val : Wrapper n F.E → F.E) ⋙ F.p) := by
    -- Let `V'` be an object in `Wrapper n F.E` (which is just `⟨V⟩` for `V : F.E`).
    -- Let `α : X ⟶ p'(V')` be a morphism in `B`.
    -- Note that `p'(V') = F.p.obj V`.
    -- Since `F.p` is a fibration, there exists a Cartesian lift `f : U ⟶ V` covering `α`.
    -- We claim `f` (viewed as a morphism in `Wrapper`) is the Cartesian lift for `p'`.
    -- The morphism in `Wrapper` is just `f`.
    -- Its image under `p'` is `F.p.map f`, which covers `α`.
    -- We need to check the universal property.
    -- Let `g' : W' ⟶ V'` and `h : p'(W') ⟶ p'(U')` such that `p'(g') = h ≫ p'(f')`.
    -- This translates exactly to the condition in `F.E` via `Wrapper.val`.
    -- Since `f` is Cartesian in `F.E`, there exists a unique `k` in `F.E`...
    -- Since `Wrapper` is fully faithful (it's just a tag), `k` corresponds to a unique morphism in `Wrapper`.
    -- Thus `f` is Cartesian for `p'`.
    apply FibrationCopy F n |>.is_fib

