/-
Checking if the norm on n -> R is L-infinity (which would be 1) or L2 (which would be sqrt 2).
-/
open Matrix Real InnerProductSpace
open scoped BigOperators

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Check the norm of a constant vector in n -> R. -/
def check_norm_L2_vs_Linf : Prop :=
  let v : Fin 2 → ℝ := fun _ => 1
  ‖v‖ = 1

theorem check_norm_is_Linf : check_norm_L2_vs_Linf := by
  rw [check_norm_L2_vs_Linf]
  simp [Pi.norm_def]
  -- The supremum of the constant function 1 over any finite set is 1.
  simp [Finset.sup_const]

/-
The Laplacian applied to b is the projection of b onto W^⊥.
-/
open Matrix Real InnerProductSpace MeasureTheory
open scoped BigOperators

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The Laplacian applied to b is the projection of b onto W^⊥. -/
lemma laplacian_apply (W : Submodule ℝ (EuclideanSpace ℝ n)) [W.HasOrthogonalProjection] (b : EuclideanSpace ℝ n) :
  _root_.laplacian W *ᵥ b = (Submodule.orthogonalProjection W.orthogonal) b := by
    unfold _root_.laplacian;
    ext i;
    simp +decide [ Matrix.one_apply, Matrix.mulVec, dotProduct ];
    simp +decide [ Matrix.toLin', LinearMap.toMatrix_apply ];
    -- By definition of the star projection, we know that $W.starProjection b i = \sum_{x} W.starProjection (EuclideanSpace.single x 1) i * b x$.
    have h_star_proj : W.starProjection b i = ∑ x, W.starProjection (EuclideanSpace.single x 1) i * b x := by
      have h_star_proj : W.starProjection b = ∑ x, b x • W.starProjection (EuclideanSpace.single x 1) := by
        convert ( W.starProjection ).pi_apply_eq_sum_univ b;
        aesop;
      rw [ h_star_proj, Finset.sum_apply, Finset.sum_congr rfl ] ; intros ; simp +decide [ mul_comm ];
    simp +decide [ h_star_proj, sub_mul, Finset.sum_sub_distrib ]

/-
Defining the correct Gaussian likelihood using L2 norm and proving it matches the noise model.
-/
open Matrix Real InnerProductSpace MeasureTheory
open scoped BigOperators

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The corrected Gaussian likelihood using L2 norm. -/
noncomputable def gaussianLikelihood_correct (b : EuclideanSpace ℝ n) (A : Matrix n n ℝ) (σ : ℝ) : ℝ :=
  Real.exp (- (‖(WithLp.equiv 2 (n → ℝ)).symm (A *ᵥ b)‖)^2 / (2 * σ^2))

/-- The corrected likelihood matches the noise model for Laplacians. -/
lemma likelihood_correct_of_laplacian (b : EuclideanSpace ℝ n) (W : Submodule ℝ (EuclideanSpace ℝ n)) [W.HasOrthogonalProjection] (σ : ℝ) :
  gaussianLikelihood_correct b (_root_.laplacian W) σ = Real.exp (- ‖(Submodule.orthogonalProjection W.orthogonal) b‖^2 / (2 * σ^2)) := by
  rw [gaussianLikelihood_correct]
  congr 3
  rw [laplacian_apply]
  -- Now we have ‖symm (P_perp b)‖^2 = ‖P_perp b‖^2
  -- P_perp b is in EuclideanSpace ℝ n, which is WithLp 2 (n → ℝ).
  -- But laplacian_apply returns `_root_.laplacian W *ᵥ b` which has type `n → ℝ` (via coercion/unfolding).
  -- Wait, `laplacian_apply` stated: `_root_.laplacian W *ᵥ b = (Submodule.orthogonalProjection W.orthogonal) b`
  -- The LHS is `n → ℝ` (implicitly). The RHS is `EuclideanSpace ℝ n`.
  -- This equality holds because `EuclideanSpace ℝ n` is defeq to `n → ℝ` (as types, but not as normed spaces).
  -- So `(WithLp.equiv 2 (n → ℝ)).symm` applied to the LHS is the same as applied to the RHS.
  -- And `(WithLp.equiv 2 (n → ℝ)).symm` applied to `(P_perp b)` (viewed as `n → ℝ`) is just `P_perp b` (viewed as `EuclideanSpace`).
  -- Because `WithLp.equiv` is just the identity on the underlying data.
  -- And `P_perp b` already has the `WithLp` structure (it is a `EuclideanSpace`).
  -- So `symm (P_perp b)` is `P_perp b`.
  simp only [WithLp.equiv_symm_apply]
  -- We need to show `‖toLp 2 (P_perp b)‖ = ‖P_perp b‖`.
  -- `toLp 2` constructs a `WithLp 2` from the underlying type.
  -- `P_perp b` is already `EuclideanSpace`, i.e., `WithLp 2`.
  -- Wait, `P_perp b` has type `EuclideanSpace ℝ n`.
  -- `laplacian_apply` says `LHS = RHS`.
  -- So `LHS` (as `n → ℝ`) is equal to `RHS` (as `n → ℝ`).
  -- `gaussianLikelihood_correct` takes `LHS`, converts to `WithLp 2`, takes norm.
  -- We want this to equal `‖RHS‖`.
  -- `RHS` is `EuclideanSpace`, so `‖RHS‖` is L2 norm.
  -- `LHS` converted to `WithLp 2` is `RHS` converted to `WithLp 2`.
  -- `RHS` is already `WithLp 2`.
  -- So we just need to check that `WithLp.equiv` preserves the norm (or rather, defines it).
  -- `WithLp.equiv` is an isometry? No, `WithLp.equiv` is an equivalence of types.
  -- The norm on `WithLp 2` is the L2 norm.
  -- So `‖(WithLp.equiv 2 (n → ℝ)).symm x‖` is the L2 norm of `x`.
  -- So we just need to show `‖(WithLp.equiv 2 (n → ℝ)).symm (P_perp b)‖ = ‖P_perp b‖`.
  -- Since `P_perp b` is `EuclideanSpace`, it is `WithLp 2`.
  -- `(WithLp.equiv 2 (n → ℝ)).symm` takes the underlying function and wraps it in `WithLp 2`.
  -- `P_perp b` IS that wrapper.
  -- So they are the same term.
  simp +decide [ Norm.norm ]

/-
There exists a subspace of dimension k if k ≤ n.
-/
open Matrix Real InnerProductSpace MeasureTheory
open scoped BigOperators
open Classical

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- There exists a subspace of dimension k if k ≤ n. -/
lemma exists_subspace_dim_k (k : ℕ) (hk : k ≤ Fintype.card n) :
  ∃ W : Submodule ℝ (EuclideanSpace ℝ n), Module.finrank ℝ W = k := by
    obtain ⟨s, hs⟩ : ∃ s : Finset n, s.card = k := by
      have := Finset.exists_subset_card_eq hk; tauto;
    refine' ⟨ Submodule.span ℝ ( Set.range ( fun i : s => EuclideanSpace.single ( i : n ) ( 1 : ℝ ) ) ), _ ⟩;
    rw [ finrank_span_eq_card ] ; aesop;
    refine' Fintype.linearIndependent_iff.2 _;
    intro g hg i; replace hg := congr_fun hg i; simp_all +decide [ Finset.sum_apply, EuclideanSpace.single_apply ] ;
    rw [ Finset.sum_apply, Finset.sum_eq_single i ] at hg <;> aesop

